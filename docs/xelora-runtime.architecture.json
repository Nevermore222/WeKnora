  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime Forms",
      "items": [
        "Standard runs Vue/Nginx and Gin as Docker services",
        "Personal runs the same Vue UI in Wails with a loopback Gin runtime",
        "desktopremote profiles proxy Personal sessions to a selected server"
      ]
    },
    {
      "dot": "violet",
      "title": "Primary Path",
      "items": [
        "Auth middleware resolves user, tenant, role, and shared-resource scope",
        "Session services select quick RAG or the ReAct agent pipeline",
        "SSE returns reasoning and answer events through the originating API path"
      ]
    },
    {
      "dot": "emerald",
      "title": "Runtime Ownership",
      "items": [
        "Xelora owns session, workspace, job, policy, artifact, and history contracts",
        "Controlled Docker is the validated provider; OpenSandbox remains experimental",
        "Workspace boundary checks reject invalid or escaping artifact paths"
      ]
    },
    {
      "dot": "rose",
      "title": "Repository Evidence",
      "items": [
        "DI: internal/container/container.go",
        "HTTP and trust gates: internal/router/router.go",
        "Provider seam: internal/executor/provider.go",
        "Pipelines: session_knowledge_qa.go and session_agent_qa.go"
      ]
    }
  ]
