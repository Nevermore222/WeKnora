# Copy to a private .env on 192.168.9.177 and replace every placeholder.
XELORA_BRAND_PROFILE=internal
XELORA_PROCESS_ROLE=active
AUTO_MIGRATE=false
AUTO_RECOVER_DIRTY=false

# Use already loaded or approved Knavis images. Do not build during cutover.
XELORA_APP_IMAGE=replace-with-approved-knavis-app-image
XELORA_FRONTEND_IMAGE=replace-with-approved-knavis-frontend-image
XELORA_DOCREADER_IMAGE=replace-with-approved-docreader-image
XELORA_RUNTIME_VERSION=latest

DB_HOST=postgres
DB_PORT=5432
DB_NAME=Xelora
DB_USER=replace-me
DB_PASSWORD=replace-me
REDIS_ADDR=redis:6379
REDIS_PASSWORD=replace-me

STORAGE_TYPE=minio
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY_ID=replace-me
MINIO_SECRET_ACCESS_KEY=replace-me
MINIO_BUCKET_NAME=knavis-production

# Preserve the existing values that decrypt imported production records.
TENANT_AES_KEY=replace-with-existing-tenant-key
SYSTEM_AES_KEY=replace-with-existing-32-byte-system-key
CRYPTO_MASTER_KEY=replace-with-existing-master-key
CRYPTO_SALT=replace-with-existing-salt

XELORA_WORKSPACE_HOST_ROOT=D:\Knavis\workspaces
XELORA_WORKSPACE_CONTAINER_ROOT=/workspaces
APP_PORT=8080
FRONTEND_PORT=80
KNAVIS_MAINTENANCE_BIND_IP=192.168.9.177
